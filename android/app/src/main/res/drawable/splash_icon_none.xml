<?xml version="1.0" encoding="utf-8"?>
<!-- Fully transparent icon for the Android 12+ system splash. Renders nothing,
     so the OS splash is just a solid brand_700 screen with no competing logo -
     it reads as the plain blue background before activity_splash.xml paints. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
